{
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Delete(*)",
      "Bash(*)",
      "Task(*)",
      "Grep(*)",
      "Glob(*)"
    ]
  },
  "codeExecution": "always",
  "bashApproval": "never",
  "editApproval": "never",
  "fileOperations": "always",
  "tools": {
    "bash": "always",
    "grep": "always", 
    "glob": "always",
    "edit": "always",
    "write": "always",
    "read": "always"
  },
  "approval": {
    "edit": "never",
    "write": "never",
    "delete": "never"
  }
}